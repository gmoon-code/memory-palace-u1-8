# Runtime
MEMORY_PALACE_ENV=development
MEMORY_PALACE_HOST=0.0.0.0
MEMORY_PALACE_PORT=8000

# Content Studio stays disabled until it is deliberately enabled on a trusted server.
MEMORY_PALACE_ADMIN_ENABLED=false

# Required before Content Studio authentication can be used.
# Never commit real values. Generate them locally with scripts/generate_admin_credentials.py
MEMORY_PALACE_ADMIN_USERNAME=admin
MEMORY_PALACE_ADMIN_PASSWORD_HASH=
MEMORY_PALACE_ADMIN_SESSION_SECRET=

# Optional security tuning.
MEMORY_PALACE_ADMIN_SESSION_TTL_SECONDS=28800
MEMORY_PALACE_ADMIN_LOGIN_WINDOW_SECONDS=600
MEMORY_PALACE_ADMIN_LOGIN_FAILURE_LIMIT=5
MEMORY_PALACE_ADMIN_DB=server_data/admin-security.sqlite3

# Draft and revision storage. This file stays server-side and is ignored by Git.
# Draft writes never modify published AP Biology content files.
MEMORY_PALACE_ADMIN_DRAFT_DB=server_data/content-studio-drafts.sqlite3

# Media Library server-side state and staged files.
MEMORY_PALACE_ADMIN_MEDIA_DB=server_data/content-studio-media.sqlite3
MEMORY_PALACE_ADMIN_MEDIA_DIR=server_data/content-studio-media

# Controlled publication. All gates default to off.
# Candidate packages and release history stay server-side until an explicitly configured
# GitHub publication action is requested by an authenticated owner.
MEMORY_PALACE_ADMIN_PUBLICATION_ENABLED=false
MEMORY_PALACE_ADMIN_PUBLICATION_DB=server_data/content-studio-publication.sqlite3
MEMORY_PALACE_ADMIN_PUBLICATION_DIR=server_data/content-studio-publications

# Optional GitHub delivery for validated candidates. Never commit a real token.
# The token must be scoped only to the repository and permissions needed to create
# candidate branches and pull requests. Server-side merge remains a separate gate.
MEMORY_PALACE_GITHUB_PUBLICATION_ENABLED=false
MEMORY_PALACE_GITHUB_REPOSITORY=gmoon-code/memory-palace-u1-8
MEMORY_PALACE_GITHUB_TOKEN=
MEMORY_PALACE_GITHUB_BASE_BRANCH=main
MEMORY_PALACE_GITHUB_ALLOW_MERGE=false
MEMORY_PALACE_GITHUB_API_URL=https://api.github.com
