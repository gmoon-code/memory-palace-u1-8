# V2 starter uses no secrets yet.
# Add deployment secrets through your hosting provider / GitHub Secrets, not here.
MEMORY_PALACE_ENV=development
MEMORY_PALACE_HOST=0.0.0.0
MEMORY_PALACE_PORT=8000

# Content Studio is disabled unless explicitly enabled on a trusted server.
# Step 1 exposes no write API. Authentication and write protection are added before editing is enabled.
MEMORY_PALACE_ADMIN_ENABLED=false
